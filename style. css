
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #07111f;
    color: #ffffff;
}

header {
    background: #0b192b;
    padding: 25px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #183653;
}

.logo {
    font-size: 28px;
    font-weight: bold;
    color: #ffffff;
}

.logo span {
    color: #00d9ff;
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 30px;
}

.nav-links a {
    text-decoration: none;
    color: #c5d4e5;
    transition: 0.3s;
}

.nav-links a:hover {
    color: #00d9ff;
}

.nav-button,
.main-button {
    background: #00bce4;
    color: #07111f;
    padding: 13px 22px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: bold;
    display: inline-block;
}

.hero {
    min-height: 600px;
    display: flex;
    align-items: center;
    padding: 80px 10%;
    background: linear-gradient(120deg, #07111f, #102c48);
}

.hero-content {
    max-width: 700px;
}

.subtitle {
    color: #00d9ff;
    letter-spacing: 3px;
    margin-bottom: 25px;
}

.hero h1 {
    font-size: 55px;
    line-height: 1.2;
    margin-bottom: 25px;
}

.hero h1 span {
    color: #00d9ff;
}

.description {
    color: #b7c8d9;
    font-size: 18px;
    line-height: 1.8;
    margin-bottom: 30px;
}

.services,
.about,
.contact {
    padding: 80px 10%;
    text-align: center;
}

.services h2,
.about h2,
.contact h2 {
    font-size: 35px;
    margin-bottom: 35px;
}

.service-container {
    display: flex;
    justify-content: center;
    gap: 25px;
    flex-wrap: wrap;
}

.service-card {
    background: #10243a;
    border: 1px solid #1d4663;
    padding: 35px;
    border-radius: 12px;
    flex: 1;
    min-width: 220px;
    transition: 0.3s;
}

.service-card:hover {
    transform: translateY(-8px);
    border-color: #00d9ff;
}

.service-card h3 {
    color: #00d9ff;
    margin-bottom: 15px;
}

.service-card p,
.about p,
.contact p {
    color: #b7c8d9;
    line-height: 1.8;
}

footer {
    background: #050c16;
    text-align: center;
    padding: 25px;
    color: #8da4b9;
}

@media (max-width: 768px) {
    header {
        flex-direction: column;
        gap: 20px;
    }

    .nav-links {
        flex-wrap: wrap;
        justify-content: center;
    }

    .hero h1 {
        font-size: 38px;
    }
}
