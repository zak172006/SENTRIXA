// SENTRIXA - Security Scan Database Model

const mongoose = require("mongoose");

const scanSchema = new mongoose.Schema({

    scanId: {
        type: String,
        unique: true,
        sparse: true
    },

    name: {
        type: String,
        required: true,
        trim: true
    },

    scanType: {
        type: String,
        enum: [
            "network",
            "website",
            "server",
            "device",
            "vulnerability",
            "full",
            "custom"
        ],
        default: "custom"
    },

    target: {
        type: String,
        required: true,
        trim: true
    },

    status: {
        type: String,
        enum: [
            "queued",
            "running",
            "completed",
            "failed",
            "cancelled"
        ],
        default: "queued"
    },

    initiatedBy: {
        type: mongoose.Schema.Types.ObjectId,
        ref: "User",
        default: null
    },

    startedAt: {
        type: Date,
        default: null
    },

    completedAt: {
        type: Date,
        default: null
    },

    duration: {
        type: Number,
        default: 0
    },

    results: {
        totalFindings: {
            type: Number,
            default: 0
        },

        critical: {
            type: Number,
            default: 0
        },

        high: {
            type: Number,
            default: 0
        },

        medium: {
            type: Number,
            default: 0
        },

        low: {
            type: Number,
            default: 0
        },

        info: {
            type: Number,
            default: 0
        }
    },

    findings: [{
        title: String,
        description: String,

        severity: {
            type: String,
            enum: [
                "critical",
                "high",
                "medium",
                "low",
                "info"
            ],
            default: "info"
        },

        category: String,

        affectedAsset: String,

        recommendation: String
    }],

    errorMessage: {
        type: String,
        default: null
    },

    configuration: {
        type: mongoose.Schema.Types.Mixed,
        default: {}
    },

    metadata: {
        type: mongoose.Schema.Types.Mixed,
        default: {}
    }

}, {
    timestamps: true
});

// Database indexes

scanSchema.index({ status: 1 });

scanSchema.index({ scanType: 1 });

scanSchema.index({ initiatedBy: 1 });

scanSchema.index({ createdAt: -1 });

const Scan = mongoose.model("Scan", scanSchema);

module.exports = Scan;