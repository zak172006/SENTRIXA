
/* =========================================
   SENTRIXA - PROFESSIONAL SECURITY DASHBOARD
========================================= */

:root {
    --bg: #050d19;
    --sidebar: #081525;
    --surface: #0d1d30;
    --card: #10243a;
    --cyan: #00d9ff;
    --blue: #087cff;
    --white: #ffffff;
    --muted: #91a8bf;
    --green: #00e6a0;
    --red: #ff526b;
    --orange: #ffb547;
    --border: rgba(0, 217, 255, 0.13);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    background: var(--bg);
    color: var(--white);
    font-family: Arial, sans-serif;
    min-height: 100vh;
    overflow-x: hidden;
    background-image:
        radial-gradient(
            circle at 80% 10%,
            rgba(0, 217, 255, 0.09),
            transparent 30%
        ),
        radial-gradient(
            circle at 10% 80%,
            rgba(0, 124, 255, 0.08),
            transparent 35%
        );
}

/* MAIN LAYOUT */

.dashboard {
    display: flex;
    min-height: 100vh;
}

/* SIDEBAR */

.sidebar {
    width: 260px;
    min-height: 100vh;
    background: rgba(8, 21, 37, 0.96);
    border-left: 1px solid var(--border);
    padding: 30px 20px;
    position: fixed;
    right: 0;
    top: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    z-index: 10;
    backdrop-filter: blur(15px);
}

.logo {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 23px;
    font-weight: bold;
    letter-spacing: 2px;
    margin-bottom: 55px;
    color: var(--white);
}

.logo span {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    color: #00121d;
    background: var(--cyan);
    box-shadow: 0 0 25px rgba(0, 217, 255, 0.4);
}

.menu-title {
    color: var(--muted);
    font-size: 12px;
    margin-bottom: 18px;
}

.sidebar nav {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.sidebar nav a {
    text-decoration: none;
    color: var(--muted);
    padding: 15px;
    border-radius: 10px;
    transition: 0.3s ease;
    font-size: 14px;
}

.sidebar nav a:hover,
.sidebar nav a.active {
    color: var(--cyan);
    background: rgba(0, 217, 255, 0.09);
    transform: translateX(-5px);
    box-shadow: inset -3px 0 var(--cyan);
}

.sidebar-status {
    margin-top: auto;
    padding: 15px 10px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 12px;
}

.status-dot {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--green);
    margin-left: 7px;
    box-shadow: 0 0 12px var(--green);
    animation: pulse 1.5s infinite;
}

/* MAIN CONTENT */

.main-content {
    width: calc(100% - 260px);
    margin-right: 260px;
    padding: 35px;
}

/* TOPBAR */

.topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 35px;
}

.topbar h1 {
    font-size: 25px;
    margin-bottom: 8px;
}

.topbar p {
    color: var(--muted);
    font-size: 13px;
}

.user-profile {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--muted);
    font-size: 13px;
}

.user-avatar {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--cyan), var(--blue));
    color: #00121d;
    font-weight: bold;
}

/* WELCOME SECTION */

.welcome {
    position: relative;
    overflow: hidden;
    min-height: 190px;
    padding: 35px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background:
        linear-gradient(
            120deg,
            rgba(0, 217, 255, 0.12),
            rgba(8, 21, 37, 0.8)
        );
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 30px;
}

.welcome-label {
    color: var(--cyan);
    font-size: 11px;
    letter-spacing: 3px;
}

.welcome h2 {
    font-size: 30px;
    margin: 18px 0 12px;
}

.welcome p {
    color: var(--muted);
    font-size: 14px;
}

.welcome-icon {
    font-size: 110px;
    color: var(--cyan);
    opacity: 0.6;
    text-shadow: 0 0 35px var(--cyan);
    animation: float 4s ease-in-out infinite;
}

/* STATISTICS */

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin-bottom: 30px;
}

.stat-card {
    padding: 25px 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 15px;
    transition: 0.35s ease;
}

.stat-card:hover {
    transform: translateY(-7px);
    border-color: var(--cyan);
    box-shadow: 0 12px 30px rgba(0, 217, 255, 0.1);
}

.stat-card span {
    color: var(--muted);
    font-size: 13px;
}

.stat-card h2 {
    font-size: 30px;
    margin: 18px 0 10px;
}

.stat-card small {
    color: var(--muted);
    font-size: 11px;
}

.cyan {
    color: var(--cyan);
}

.green {
    color: var(--green);
}

/* PANELS */

.panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 25px;
    margin-bottom: 25px;
}

.panel-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    margin-bottom: 25px;
}

.panel-heading h2 {
    font-size: 19px;
    margin-bottom: 8px;
}

.panel-heading p {
    font-size: 12px;
    color: var(--muted);
}

.live-badge {
    padding: 7px 13px;
    border: 1px solid var(--cyan);
    border-radius: 20px;
    color: var(--cyan);
    font-size: 10px;
    letter-spacing: 1px;
}

/* THREAT ROWS */

.threat-row {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 18px 0;
    border-top: 1px solid var(--border);
}

.threat-row > div {
    flex: 1;
}

.threat-row strong {
    font-size: 14px;
}

.threat-row p {
    color: var(--muted);
    font-size: 11px;
    margin-top: 7px;
}

.threat-icon {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    font-weight: bold;
}

.danger {
    background: rgba(255, 82, 107, 0.12);
    color: var(--red);
}

.warning {
    background: rgba(255, 181, 71, 0.12);
    color: var(--orange);
}

.safe {
    background: rgba(0, 230, 160, 0.12);
    color: var(--green);
}

.severity {
    font-size: 11px;
    padding: 7px 11px;
    border-radius: 20px;
}

.high {
    color: var(--red);
    background: rgba(255, 82, 107, 0.1);
}

.medium {
    color: var(--orange);
    background: rgba(255, 181, 71, 0.1);
}

.low {
    color: var(--green);
    background: rgba(0, 230, 160, 0.1);
}

/* ACTIVITY */

.activity-box {
    border-right: 2px solid rgba(0, 217, 255, 0.3);
    padding-right: 20px;
}

.activity-line {
    position: relative;
    margin-bottom: 25px;
}

.activity-line:last-child {
    margin-bottom: 0;
}

.activity-line span {
    position: absolute;
    right: -27px;
    top: 3px;
    width: 10px;
    height: 10px;
    background: var(--cyan);
    border-radius: 50%;
    box-shadow: 0 0 12px var(--cyan);
}

.activity-line p {
    font-size: 13px;
    margin-bottom: 7px;
}

.activity-line small {
    color: var(--muted);
    font-size: 11px;
}

/* FOOTER */

footer {
    text-align: center;
    color: var(--muted);
    padding: 25px 10px;
    font-size: 11px;
    border-top: 1px solid var(--border);
}

/* ANIMATIONS */

@keyframes pulse {
    0%, 100% {
        opacity: 1;
        box-shadow: 0 0 12px var(--green);
    }

    50% {
        opacity: 0.4;
        box-shadow: 0 0 3px var(--green);
    }
}

@keyframes float {
    0%, 100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-12px);
    }
}

/* RESPONSIVE DESIGN */

@media (max-width: 1100px) {
    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 768px) {
    .sidebar {
        position: relative;
        width: 100%;
        min-height: auto;
        padding: 20px;
        border-left: none;
        border-bottom: 1px solid var(--border);
    }

    .logo {
        margin-bottom: 20px;
    }

    .sidebar nav {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
    }

    .sidebar-status {
        margin-top: 20px;
    }

    .dashboard {
        display: block;
    }

    .main-content {
        width: 100%;
        margin-right: 0;
        padding: 20px;
    }

    .topbar {
        align-items: flex-start;
    }

    .topbar h1 {
        font-size: 20px;
    }

    .welcome {
        padding: 25px;
    }

    .welcome h2 {
        font-size: 23px;
    }

    .welcome-icon {
        font-size: 65px;
    }

    .stats-grid {
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .stat-card {
        padding: 18px 12px;
    }

    .stat-card h2 {
        font-size: 24px;
    }

    .panel {
        padding: 18px 13px;
    }
}

@media (max-width: 420px) {
    .user-profile {
        font-size: 10px;
    }

    .welcome-icon {
        display: none;
    }

    .stats-grid {
        grid-template-columns: 1fr;
    }

    .threat-row {
        gap: 9px;
    }

    .threat-row strong {
        font-size: 12px;
    }

    .severity {
        font-size: 9px;
        padding: 6px;
    }
}

/* ACCESSIBILITY */

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
    }
}
