
/* ==========================================
   SENTRIXA - Professional Security Dashboard
   ========================================== */

:root {
    --bg: #050d19;
    --sidebar: #081525;
    --surface: #0d1d30;
    --surface-light: #122941;
    --cyan: #00d9ff;
    --blue: #087cff;
    --green: #00e6a0;
    --red: #ff4d6d;
    --orange: #ffb547;
    --text: #eaf6ff;
    --muted: #91a8bd;
    --border: rgba(0, 217, 255, 0.13);
    --shadow: 0 10px 35px rgba(0, 0, 0, 0.25);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "Segoe UI", Tahoma, Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    overflow-x: hidden;
}

/* ==========================================
   DIGITAL BACKGROUND
   ========================================== */

body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -1;

    background-image:
        linear-gradient(rgba(0, 217, 255, 0.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 217, 255, 0.025) 1px, transparent 1px);

    background-size: 45px 45px;
    mask-image: linear-gradient(to bottom, black, transparent 90%);
}

body::after {
    content: "";
    position: fixed;
    width: 400px;
    height: 400px;
    top: -150px;
    left: -120px;
    border-radius: 50%;
    background: rgba(0, 140, 255, 0.08);
    filter: blur(100px);
    pointer-events: none;
    z-index: -1;
}

/* ==========================================
   MAIN DASHBOARD
   ========================================== */

.dashboard {
    display: flex;
    min-height: 100vh;
}

/* ==========================================
   SIDEBAR
   ========================================== */

.sidebar {
    width: 260px;
    height: 100vh;
    position: fixed;
    top: 0;
    right: 0;
    z-index: 100;

    background: var(--sidebar);
    border-left: 1px solid var(--border);

    padding: 28px 20px;
    display: flex;
    flex-direction: column;

    box-shadow: -10px 0 35px rgba(0, 0, 0, 0.15);
}

.sidebar h2 {
    color: var(--cyan);
    font-size: 25px;
    letter-spacing: 2px;
    margin-bottom: 45px;
    text-align: center;

    text-shadow: 0 0 15px rgba(0, 217, 255, 0.35);
}

.sidebar nav {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.sidebar nav a {
    text-decoration: none;
    color: var(--muted);

    padding: 14px 16px;
    border-radius: 10px;

    display: flex;
    align-items: center;
    gap: 12px;

    transition: 0.3s ease;
    border: 1px solid transparent;
}

.sidebar nav a:hover,
.sidebar nav a.active {
    color: var(--cyan);
    background: rgba(0, 217, 255, 0.08);
    border-color: var(--border);

    box-shadow: 0 0 18px rgba(0, 217, 255, 0.06);
    transform: translateX(-4px);
}

/* ==========================================
   MAIN CONTENT
   ========================================== */

.main-content {
    width: calc(100% - 260px);
    margin-right: 260px;
    padding: 30px;
    min-width: 0;
}

/* ==========================================
   TOPBAR
   ========================================== */

.topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;

    margin-bottom: 35px;
    padding-bottom: 20px;

    border-bottom: 1px solid var(--border);
}

.topbar h1 {
    font-size: 24px;
    color: var(--text);
}

.topbar p {
    color: var(--muted);
    font-size: 13px;
    margin-top: 7px;
}

/* ==========================================
   WELCOME SECTION
   ========================================== */

.welcome {
    position: relative;
    overflow: hidden;

    background:
        linear-gradient(115deg, rgba(0, 217, 255, 0.13), rgba(8, 124, 255, 0.06)),
        var(--surface);

    border: 1px solid var(--border);
    border-radius: 18px;

    padding: 35px;
    margin-bottom: 30px;

    box-shadow: var(--shadow);
}

.welcome::before {
    content: "";
    position: absolute;
    width: 220px;
    height: 220px;
    left: -60px;
    top: -100px;

    border-radius: 50%;
    background: rgba(0, 217, 255, 0.08);
    filter: blur(35px);
}

.welcome h2 {
    position: relative;
    font-size: 27px;
    margin-bottom: 12px;
}

.welcome p {
    position: relative;
    color: var(--muted);
    line-height: 1.8;
    max-width: 650px;
}

/* ==========================================
   STATISTICS
   ========================================== */

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin-bottom: 30px;
}

.stat-card {
    position: relative;
    overflow: hidden;

    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 15px;

    padding: 24px;
    min-width: 0;

    box-shadow: var(--shadow);
    transition: 0.3s ease;
}

.stat-card::before,
.panel::before {
    content: "";
    position: absolute;
    top: 0;
    right: 15%;
    width: 70%;
    height: 2px;

    background: linear-gradient(
        90deg,
        transparent,
        var(--cyan),
        transparent
    );

    opacity: 0;
    transition: 0.3s ease;
}

.stat-card:hover,
.panel:hover {
    transform: translateY(-5px);
    border-color: rgba(0, 217, 255, 0.35);

    box-shadow:
        0 15px 35px rgba(0, 0, 0, 0.3),
        0 0 20px rgba(0, 217, 255, 0.05);
}

.stat-card:hover::before,
.panel:hover::before {
    opacity: 1;
}

.stat-card p {
    color: var(--muted);
    font-size: 14px;
    margin-bottom: 15px;
}

.stat-card h2 {
    font-size: 30px;
    color: var(--cyan);
    margin-bottom: 10px;
}

.stat-card span {
    color: var(--green);
    font-size: 12px;
}

/* ==========================================
   PANELS
   ========================================== */

.panels-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
    margin-bottom: 30px;
}

.panel {
    position: relative;
    overflow: hidden;

    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;

    padding: 25px;
    min-width: 0;

    box-shadow: var(--shadow);
    transition: 0.3s ease;
}

.panel h3 {
    font-size: 18px;
    margin-bottom: 22px;
    color: var(--text);
}

/* ==========================================
   THREATS
   ========================================== */

.threat-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;

    padding: 15px 0;
    border-bottom: 1px solid var(--border);

    transition: 0.3s ease;
}

.threat-row:last-child {
    border-bottom: none;
}

.threat-row:hover {
    padding-right: 8px;
    background: rgba(0, 217, 255, 0.025);
}

.threat-row strong {
    font-size: 14px;
    display: block;
    margin-bottom: 6px;
}

.threat-row p {
    font-size: 12px;
    color: var(--muted);
}

.threat-row span {
    font-size: 11px;
    padding: 6px 10px;
    border-radius: 20px;
    white-space: nowrap;
}

.status-danger {
    color: var(--red);
    background: rgba(255, 77, 109, 0.12);
}

.status-warning {
    color: var(--orange);
    background: rgba(255, 181, 71, 0.12);
}

.status-safe {
    color: var(--green);
    background: rgba(0, 230, 160, 0.12);
}

/* ==========================================
   ACTIVITY
   ========================================== */

.activity-item {
    display: flex;
    align-items: flex-start;
    gap: 13px;

    padding: 14px 0;
    border-bottom: 1px solid var(--border);
}

.activity-item:last-child {
    border-bottom: none;
}

.activity-icon {
    width: 36px;
    height: 36px;
    flex-shrink: 0;

    display: flex;
    justify-content: center;
    align-items: center;

    background: rgba(0, 217, 255, 0.1);
    border-radius: 10px;
    color: var(--cyan);
}

.activity-item strong {
    font-size: 13px;
    display: block;
    margin-bottom: 5px;
}

.activity-item p {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.6;
}

/* ==========================================
   FOOTER
   ========================================== */

footer {
    text-align: center;
    color: var(--muted);
    font-size: 12px;

    padding: 25px 10px;
    border-top: 1px solid var(--border);
    margin-top: 20px;
}

/* ==========================================
   ANIMATIONS
   ========================================== */

@keyframes dashboardAppear {
    from {
        opacity: 0;
        transform: translateY(18px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes pulse {
    0%, 100% {
        opacity: 1;
    }

    50% {
        opacity: 0.55;
    }
}

@keyframes float {
    0%, 100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-6px);
    }
}

.welcome {
    animation: dashboardAppear 0.6s ease both;
}

.stat-card {
    animation: dashboardAppear 0.6s ease both;
}

.stat-card:nth-child(2) {
    animation-delay: 0.1s;
}

.stat-card:nth-child(3) {
    animation-delay: 0.2s;
}

.stat-card:nth-child(4) {
    animation-delay: 0.3s;
}

.panel {
    animation: dashboardAppear 0.7s ease both;
}

/* ==========================================
   RESPONSIVE - TABLETS
   ========================================== */

@media (max-width: 1100px) {
    .stats-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .panels-grid {
        grid-template-columns: 1fr;
    }
}

/* ==========================================
   RESPONSIVE - MOBILE
   ========================================== */

@media (max-width: 768px) {
    .sidebar {
        width: 100%;
        height: auto;
        position: relative;

        padding: 15px;
        border-left: none;
        border-bottom: 1px solid var(--border);
    }

    .sidebar h2 {
        margin-bottom: 15px;
        font-size: 22px;
    }

    .sidebar nav {
        flex-direction: row;
        justify-content: center;
        flex-wrap: wrap;
        gap: 7px;
    }

    .sidebar nav a {
        padding: 9px 12px;
        font-size: 12px;
    }

    .main-content {
        width: 100%;
        margin-right: 0;
        padding: 20px 15px;
    }

    .topbar {
        align-items: flex-start;
        flex-direction: column;
    }

    .welcome {
        padding: 25px 20px;
    }

    .welcome h2 {
        font-size: 22px;
    }

    .stats-grid {
        gap: 12px;
    }

    .stat-card {
        padding: 18px;
    }

    .stat-card h2 {
        font-size: 25px;
    }
}

@media (max-width: 480px) {
    .stats-grid {
        grid-template-columns: 1fr;
    }

    .sidebar nav {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .sidebar nav a {
        justify-content: center;
        text-align: center;
    }

    .panel {
        padding: 18px;
    }

    .threat-row {
        align-items: flex-start;
    }
}

/* ==========================================
   ACCESSIBILITY
   ========================================== */

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }
}
